<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="create" noun="PartyGroup" type="inline">
        <in-parameters>
            <parameter name="partyId" required="true"/>
            <parameter name="groupName" required="true"/>
            <parameter name="description" required="true"/>
            <attributes-all/>
        </in-parameters>
           <out-parameters>
            <parameter name="response" required="true"/>
           </out-parameters>
        <actions>
            <script location="component://party/service/createPartyGroup.groovy"/>
        </actions>


    </service>


</services>