<?xml version="1.0" encoding="UTF-8" ?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="anonymous-all">
    <parameter name="partyId"/>

<!--    <title>Create Party Group</title>-->
    <transition name="createPartyGroup">
            <service-call name="PartyGroupServices.create#PartyGroup"/>
            <default-response url="/qapps/partyScreen"/>
    </transition>

    <widgets>
        <form-single name="CreatePartyGroup" transition="createPartyGroup">
            <auto-fields-service service-name="PartyGroupServices.create#PartyGroup" field-type="edit"/>
            <field name="partyId">
                <default-field title="Party ID">
                    <display text="${partyId}"/>
                </default-field>
            </field>
            <field name="submitButton">
                    <default-field title="Create Party Group">
                        <submit/>
                    </default-field>
            </field>

        </form-single>
    </widgets>



</screen>